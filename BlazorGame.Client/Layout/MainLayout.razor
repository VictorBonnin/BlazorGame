@inherits LayoutComponentBase
@inject BlazorGame.Client.Services.PlayerSessionService Session

<div class="page">
    @* Le menu ne s'affiche que si on est connecté *@
    @if (Session.IsAuthenticated)
    {
        <NavMenu />
    }

    <main>
        <div class="content px-4">
            @Body
        </div>
    </main>
</div>