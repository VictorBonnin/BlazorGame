@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager Navigation
@* 🗑️ SUPPRESSION de la ligne suivante : *@
@* @inject SignOutSessionStateManager SignOutManager *@

<nav class="topnav">
    <div class="topnav-inner">
        <div class="brand">
            <NavLink href="/" class="brand-link">Blazor Game Quest</NavLink>
        </div>

        <button class="hamburger" @onclick="Toggle" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>

        <div class="links @(open ? "open" : null)">
            <NavLink href="/" class="navlink" Match="NavLinkMatch.All">Accueil</NavLink>
            <NavLink href="/rules" class="navlink">Règles</NavLink>
            <NavLink href="/new-adventure" class="navlink">Nouvelle aventure</NavLink>
            <NavLink href="/leaderboard" class="navlink">Classement</NavLink>
            <NavLink href="/profile" class="navlink">Profil</NavLink>

            <AuthorizeView Roles="admin">
                <Authorized>
                    <NavLink href="/admin" class="navlink">Admin</NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <span class="nav-text">👋 @context.User.Identity?.Name</span>
                    @* Correction ici : On appelle BeginLogOut *@
                    <button class="navlink btn-logout" @onclick="BeginLogOut">Se déconnecter</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    bool open = false;

    void Toggle() => open = !open;

    // 👇 CORRECTION : Nouvelle méthode standard pour la déconnexion
    private void BeginLogOut()
    {
        // Cette méthode gère automatiquement l'état de déconnexion
        Navigation.NavigateToLogout("authentication/logout");
    }
}