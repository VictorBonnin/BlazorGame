@page "/new-adventure"
@using Microsoft.AspNetCore.Components.Forms
@using SharedModels.Entities
@using SharedModels

<PageTitle>Aventure</PageTitle>

<div class="card mb-4 border-secondary">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        @if (GameInProgress)
        {
            <span>Salle @CurrentRoomIndex / @DungeonRooms?.Count</span>
            <span class="badge bg-warning text-dark fs-5">🏆 Score: @CurrentAdventure?.Score</span>
        }
        else
        {
            <span>Nouvelle Partie</span>
        }
    </div>

    <div class="card-body bg-dark text-light">
        
        <div class="alert alert-info text-center">
            @Message
        </div>

        @if (GameInProgress)
        {
            <div class="mb-4">
                <label class="form-label">Santé (@CurrentHealth / 100)</label>
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" 
                         role="progressbar" 
                         style="width: @CurrentHealth%">
                    </div>
                </div>
            </div>

            @if (CurrentRoom != null)
            {
                <RoomComponent Room="@CurrentRoom" OnActionSelected="HandleAction" IsLoading="@IsLoading" />
                
                <div class="mt-3 p-3 border border-secondary rounded">
                    <h6 class="text-muted">🎒 Inventaire</h6>
                    @if (Inventory.Count == 0) { <small>Vide</small> }
                    else 
                    {
                        @foreach(var item in Inventory)
                        {
                            <span class="badge bg-secondary me-1">@item</span>
                        }
                    }
                </div>
            }
        }
        else if (!GameFinished)
        {
            <div class="text-center mt-5">
                <h1>🏰 Entrez dans le Donjon</h1>
                <p class="lead">Survivrez-vous aux pièges et aux monstres ?</p>
                <EditForm Model="@FormModel" OnValidSubmit="StartAdventure">
                    <button type="submit" class="btn btn-lg btn-success px-5">JOUER</button>
                </EditForm>
            </div>
        }
        else // --- ÉCRAN DE FIN ---
        {
            <div class="text-center py-4">
                @if(CurrentHealth <= 0) 
                { 
                    <h1 class="text-danger fw-bold display-3">☠️ VOUS ÊTES MORT</h1>
                }
                else 
                { 
                    <h1 class="text-success fw-bold display-3">VICTOIRE !</h1>
                }
                
                <h2 class="text-warning mt-3">Score Final : @CurrentAdventure?.Score</h2>
                <hr class="border-secondary my-4"/>

                @* --- RÉSUMÉ DE L'AVENTURE --- *@
                <h4 class="text-white mb-3">📜 Résumé de l'expédition</h4>
                <div class="list-group text-start mb-4 mx-auto" style="max-width: 600px;">
                    @foreach (var log in AdventureLogs)
                    {
                        <div class="list-group-item list-group-item-dark d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold me-2">Salle @log.RoomIndex :</span>
                                <span>@log.Description</span>
                            </div>
                            <div class="text-end" style="min-width: 80px;">
                                @if (log.ScoreChange > 0)
                                {
                                    <span class="badge bg-warning text-dark me-1">+@log.ScoreChange pts</span>
                                }
                                @if (log.HealthChange < 0)
                                {
                                    <span class="badge bg-danger">@log.HealthChange PV</span>
                                }
                                else if (log.HealthChange > 0)
                                {
                                    <span class="badge bg-success">+@log.HealthChange PV</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex gap-3 justify-content-center mt-4">
                    <button class="btn btn-primary btn-lg" @onclick="StartAdventure">
                        🔄 Recommencer
                    </button>
                    <a href="leaderboard" class="btn btn-outline-light btn-lg">
                        🏆 Voir les scores
                    </a>
                </div>
            </div>
        }
    </div>
</div>