@page "/new-adventure"
@using Microsoft.AspNetCore.Components.Forms
@using SharedModels.Entities
@using SharedModels

<PageTitle>Aventure</PageTitle>

<div class="container" style="max-width: 800px;">
    
    @* --- EN-TÊTE : Toujours visible si jeu en cours --- *@
    @if (GameInProgress)
    {
        <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-dark text-white border border-secondary rounded shadow-sm">
            <div class="d-flex align-items-center gap-3">
                @* CORRECTION DU COMPTEUR ET INDICATEUR DE FIN *@
                @if (DungeonRooms != null)
                {
                    @* LOGIQUE CORRIGÉE : 
                       On affiche le compteur tant qu'on n'est pas strictement sur la dernière case (Sortie).
                       On compare à Count pour inclure l'avant-dernière salle.
                    *@
                    @if (CurrentRoomIndex < DungeonRooms.Count)
                    {
                        <span class="fs-5 fw-bold">Salle @CurrentRoomIndex / @(DungeonRooms.Count - 1)</span>
                    }
                    else
                    {
                        @* S'affiche uniquement quand on est sur la case de sortie *@
                        <span class="fs-5 fw-bold text-warning">🚪 Dernière Étape</span>
                    }
                }
                <span class="badge bg-warning text-dark">🏆 @CurrentAdventure?.Score pts</span>
            </div>
            
            <div class="d-flex align-items-center gap-2" style="min-width: 200px;">
                <span class="small">❤️ @CurrentHealth PV</span>
                <div class="progress flex-grow-1" style="height: 10px; background-color: #444;">
                    <div class="progress-bar bg-danger" role="progressbar" style="width: @CurrentHealth%"></div>
                </div>
            </div>
        </div>
    }

    @* --- ZONE PRINCIPALE (CARTE) --- *@
    <div class="card shadow-lg border-secondary bg-dark text-white">
        <div class="card-body text-center p-5">
            
            @if (GameInProgress && CurrentRoom != null)
            {
                // 1. FEEDBACK (Action précédente)
                @if (!string.IsNullOrEmpty(LastOutcome))
                {
                    <div class="alert alert-secondary bg-secondary text-white border-0 mb-4 animate__animated animate__fadeIn">
                        @LastOutcome
                    </div>
                }

                // 2. SCÈNE (Description Salle)
                <div class="my-5">
                    <h3 class="card-title fw-bold mb-3">Que faites-vous ?</h3>
                    <p class="card-text fs-4 fst-italic text-white-50">
                        "@CurrentRoom.Description"
                    </p>
                </div>

                // 3. ACTIONS
                @if (CurrentRoom.Type == RoomType.Exit)
                {
                    <button class="btn btn-success btn-lg px-5 py-3 shadow" @onclick="FinishAdventure">
                        🚪 Pousser la porte finale
                    </button>
                }
                else
                {
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                        <button class="btn btn-outline-danger btn-lg px-4" @onclick="() => HandleAction(PlayerAction.Combattre)">⚔️ Attaquer</button>
                        <button class="btn btn-outline-warning btn-lg px-4" @onclick="() => HandleAction(PlayerAction.Fouiller)">🔍 Fouiller</button>
                        <button class="btn btn-outline-light btn-lg px-4" @onclick="() => HandleAction(PlayerAction.Fuir)">🏃 Fuir</button>
                    </div>
                    <div class="mt-3">
                         <button class="btn btn-sm btn-link text-info text-decoration-none" @onclick="() => HandleAction(PlayerAction.UtiliserObjet)">🧪 Boire une Potion</button>
                    </div>
                }
            }
            else if (!GameFinished) // Écran d'accueil (Start)
            {
                <h1 class="display-4 fw-bold text-primary mb-3">L'Aventure Vous Attend</h1>
                <p class="lead text-white-50 mb-5">Serez-vous assez brave pour atteindre la sortie ?</p>
                <EditForm Model="@FormModel" OnValidSubmit="StartAdventure">
                    <button type="submit" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow">COMMENCER L'AVENTURE</button>
                </EditForm>
            }
            else // Écran de Fin (Game Over / Victoire)
            {
                @if (CurrentHealth > 0)
                {
                    <h1 class="text-success display-3 mb-3">🎉 VICTOIRE !</h1>
                    <p class="lead">Vous avez survécu au donjon.</p>
                }
                else
                {
                    <h1 class="text-danger display-3 mb-3">☠️ GAME OVER</h1>
                    <p class="lead">Le donjon a eu raison de vous.</p>
                }
                
                <div class="display-6 fw-bold text-warning my-4">Score : @CurrentAdventure?.Score</div>
                
                <div class="d-flex gap-3 justify-content-center mb-5">
                    <button class="btn btn-primary" @onclick="StartAdventure">🔄 Rejouer</button>
                    <a href="leaderboard" class="btn btn-outline-light">🏆 Classement</a>
                </div>

                @* --- RÉSUMÉ DE L'AVENTURE (VERSION CLAIRE) --- *@
                @if (AdventureLogs.Any())
                {
                    <hr class="border-secondary my-5" />
                    
                    @* Fond gris clair (#f8f9fa) et texte sombre pour une lisibilité maximale *@
                    <div class="card border-0 mx-auto shadow text-start" style="max-width: 700px; background-color: #f8f9fa; color: #212529;">
                        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold">📜 Journal de bord</h5>
                            <small class="badge bg-dark">@AdventureLogs.Count Étapes</small>
                        </div>
                        <div class="list-group list-group-flush">
                            @foreach(var log in AdventureLogs)
                            {
                                <div class="list-group-item border-bottom border-secondary-subtle py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center"
                                     style="background-color: transparent;">
                                    
                                    <div class="d-flex align-items-center mb-2 mb-sm-0">
                                        <span class="badge bg-dark text-white rounded-pill me-3">#@log.RoomIndex</span>
                                        <span class="fw-medium">@log.Description</span>
                                    </div>

                                    <div class="d-flex gap-2 justify-content-end" style="min-width: 120px;">
                                        @if(log.ScoreChange > 0) 
                                        { 
                                            <span class="badge bg-warning text-dark border border-warning shadow-sm">+@log.ScoreChange pts</span> 
                                        }
                                        @if(log.HealthChange < 0) 
                                        { 
                                            <span class="badge bg-danger text-white shadow-sm">@log.HealthChange PV</span> 
                                        }
                                        else if(log.HealthChange > 0) 
                                        { 
                                            <span class="badge bg-success text-white shadow-sm">+@log.HealthChange PV</span> 
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        
        @* --- PIED DE PAGE : INVENTAIRE (Uniquement en jeu) --- *@
        @if (GameInProgress)
        {
            <div class="card-footer bg-dark border-top border-secondary p-3">
                <div class="d-flex justify-content-center align-items-center flex-wrap gap-2">
                    <span class="fw-bold me-2 text-white-50">🎒 Sac :</span>
                    @if (Inventory.Count == 0)
                    {
                        <span class="small fst-italic text-muted">Vide</span>
                    }
                    else
                    {
                        @foreach(var item in Inventory)
                        {
                            <span class="badge rounded-pill bg-secondary border border-light">@item</span>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>