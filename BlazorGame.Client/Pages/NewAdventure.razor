@page "/new-adventure"
@using Microsoft.AspNetCore.Components.Forms
@using SharedModels.Entities
@using SharedModels

<PageTitle>Nouvelle Aventure</PageTitle>

<div class="card mb-4 @(GameFinished ? "border-success" : (GameInProgress ? "border-primary" : "border-info"))">
    <div class="card-header">
        @if (GameInProgress)
        {
            <h3 class="mb-0">Salle @CurrentRoomIndex <small class="text-muted">/ @DungeonRooms?.Count</small></h3>
        }
        else if (GameFinished)
        {
            <h3 class="mb-0 text-success">🎉 Aventure Terminée !</h3>
        }
        else
        {
            <h3 class="mb-0">Démarrer une Nouvelle Aventure</h3>
        }
    </div>
    <div class="card-body">
        
        @* Message d'information ou d'erreur *@
        <div class="alert @(Message.Contains("Erreur") ? "alert-danger" : "alert-info")">
             @Message
        </div>

        @* --- CAS 1 : JEU NON COMMENCÉ --- *@
        @if (!GameInProgress && !GameFinished)
        {
            @if (Session.IsAuthenticated)
            {
                <p class="text-white">Bienvenue, <strong>@Session.CurrentPlayerName</strong>. Prêt à explorer ?</p>
            }

            <EditForm Model="@FormModel" OnValidSubmit="StartAdventure">
                <DataAnnotationsValidator />
                <div class="row g-3 align-items-end">
                    <div class="col-12">
                        <p>Le donjon contiendra entre 3 et 5 salles générées aléatoirement.</p>
                        <button type="submit" class="btn btn-primary w-100 btn-lg" disabled="@IsLoading">
                            @if (IsLoading) {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Génération du donjon...</span>
                            }
                            else
                            {
                                <span>🚀 Démarrer l'Aventure</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        }

        @* --- CAS 2 : JEU EN COURS --- *@
        else if (GameInProgress)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-secondary fs-6">Joueur : @Session.CurrentPlayerName</span>
                <span class="badge bg-warning text-dark fs-5">Score : @CurrentAdventure?.Score</span>
            </div>
            
            @if (CurrentRoom != null)
            {
                <RoomComponent Room="@CurrentRoom" OnActionSelected="HandleAction" IsLoading="@IsLoading" />
            }
            else
            {
                <p class="text-danger">Erreur : Impossible de charger la salle actuelle.</p>
            }
        }

        @* --- CAS 3 : JEU TERMINÉ --- *@
        else if (GameFinished)
        {
            <div class="text-center py-4">
                <h1 class="display-4 @(CurrentAdventure?.Score < 0 ? "text-danger" : "text-success")">
                    @CurrentAdventure?.Score pts
                </h1>
                <p class="lead">
                    @if(CurrentAdventure?.Score < 0) { <span>Vous avez péri dans le donjon... 🪦</span> }
                    else { <span>Félicitations pour cette expédition ! 💰</span> }
                </p>
                
                <hr />
                
                <div class="d-grid gap-2 col-6 mx-auto">
                    <button class="btn btn-primary" @onclick="StartAdventure" disabled="@IsLoading">
                        🔄 Rejouer une partie
                    </button>
                    <a href="/leaderboard" class="btn btn-outline-secondary">
                        🏆 Voir le classement
                    </a>
                </div>
            </div>
        }
    </div>
</div>