@page "/new-adventure"

<PageTitle>Nouvelle Aventure</PageTitle>

<div class="card mb-4 @(GameFinished ? "border-success" : (GameInProgress ? "border-primary" : "border-info"))">
    <div class="card-header">
        @if (GameInProgress)
        {
            <h3 class="mb-0">Salle @CurrentRoomIndex sur @DungeonRooms?.Count</h3>
        }
        else if (GameFinished)
        {
            <h3 class="mb-0 text-success">🎉 Aventure Terminée !</h3>
        }
        else
        {
            <h3 class="mb-0">Démarrer une Nouvelle Aventure</h3>
        }
    </div>
    <div class="card-body">
        
        @* Message d'état et d'erreur *@
        <div class="alert @(Message.Contains("Erreur") ? "alert-danger" : "alert-info")">
            @Message
        </div>

        @* Formulaire de démarrage (Visible si le jeu n'est pas démarré ni terminé) *@
        @if (!GameInProgress && !GameFinished)
        {
            @if (Session.IsAuthenticated)
            {
                <div class="alert alert-success">Connecté en tant que : **@Session.CurrentPlayerName**</div>
            }

            <EditForm Model="@FormModel" OnValidSubmit="StartAdventure">
                <DataAnnotationsValidator />
                <div class="row g-3 align-items-end">
                    
                    @* LE CHAMP PlayerId A ÉTÉ RETIRÉ ICI *@

                    <div class="col-md-4">
                        <label for="minRooms" class="form-label">Min Salles</label>
                        <InputNumber id="minRooms" class="form-control" @bind-Value="FormModel.MinRooms" />
                    </div>
                    <div class="col-md-4">
                        <label for="maxRooms" class="form-label">Max Salles</label>
                        <InputNumber id="maxRooms" class="form-control" @bind-Value="FormModel.MaxRooms" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100" disabled="@IsLoading">
                            @if (IsLoading) {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Démarrer l'Aventure
                        </button>
                    </div>
                </div>
            </EditForm>
        }
        @* Affichage de l'aventure en cours *@
        else if (GameInProgress)
        {
            <div class="mb-3">
                <p>Joueur : **@Session.CurrentPlayerName**</p>
                <p>Score actuel : **@CurrentAdventure?.Score**</p>
                <p>Salle : **@CurrentRoomIndex** sur **@DungeonRooms?.Count**</p>
            </div>
            
            @if (CurrentRoom != null)
            {
                <RoomComponent Room="@CurrentRoom" OnActionSelected="HandleAction" IsLoading="@IsLoading" />
            }
        }

        @* Affichage de fin de partie *@
        else if (GameFinished)
        {
            <div class="text-center">
                <h4 class="text-success">Votre Score Final : @CurrentAdventure?.Score</h4>
                <p class="text-muted">Aventure jouée avec @CurrentAdventure?.Rooms.Count() salles.</p>
                <button class="btn btn-primary mt-3" @onclick="StartAdventure" disabled="@IsLoading">
                    Recommencer une partie
                </button>
            </div>
        }
    </div>
</div>