@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject BlazorGame.Client.Services.PlayerSessionService Session

<PageTitle>L'Aventure Commence - BlazorQuest</PageTitle>

@* vh-100 pour prendre toute la hauteur *@
<div class="vh-100 d-flex flex-column justify-content-center align-items-center text-center text-white bg-dark">
    
    <h1 class="display-3 fw-bold text-white">BlazorQuest</h1>
    
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4 text-white">
            Le royaume a besoin de héros. Oserez-vous franchir les portes du donjon ? 
            Des monstres terrifiants et des trésors légendaires attendent ceux qui sont assez braves.
        </p>
        
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center mb-4">
            @* Bouton 1 : Ajout de min-width et flex pour centrer *@
            <a href="login" 
               class="btn btn-primary btn-lg fw-bold rounded-pill shadow d-inline-flex align-items-center justify-content-center gap-2" 
               style="min-width: 250px;">
                ⚔️ COMMENCER
            </a>
        </div>
    </div>

    @* Section de présentation *@
    <div class="row mt-4 pt-3 border-top border-secondary w-75 mx-auto">
        <div class="col-lg-4">
            <div class="fs-2 mb-1">👹</div>
            <h4 class="fw-normal text-white">Combats</h4>
            <p class="small text-white-50">Affrontez des ennemis générés aléatoirement.</p>
        </div>
        <div class="col-lg-4">
            <div class="fs-2 mb-1">💎</div>
            <h4 class="fw-normal text-white">Butin</h4>
            <p class="small text-white-50">Amassez de l'or et découvrez des reliques.</p>
        </div>
        <div class="col-lg-4">
            <div class="fs-2 mb-1">📜</div>
            <h4 class="fw-normal text-white">Légende</h4>
            <p class="small text-white-50">Gravissez les échelons du classement.</p>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }
}