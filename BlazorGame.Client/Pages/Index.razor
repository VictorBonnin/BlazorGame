@page "/"
@inject BlazorGame.Client.Services.PlayerSessionService Session

<PageTitle>Tableau de Bord</PageTitle>

<div class="container text-center mt-5">
    <div class="p-5 mb-4 bg-dark text-white rounded-3 shadow border border-secondary">
        <h1 class="display-4 fw-bold">
            Bienvenue, <span class="text-info">@Session.CurrentPlayerName</span>
        </h1>
        <p class="lead mb-4">Le donjon n'attend que vous.</p>

        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a href="new-adventure" class="btn btn-success btn-lg px-5 fw-bold">
                ⚔️ JOUER
            </a>
            <a href="leaderboard" class="btn btn-outline-light btn-lg px-5">
                🏆 CLASSEMENT
            </a>
        </div>
    </div>

    <div class="mb-5">
        <HintBox />
    </div>
    
    @* Petite section informative *@
    <div class="row text-start mt-5">
        <div class="col-md-6 offset-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h5 class="card-title">Dernières nouvelles</h5>
                    <p class="card-text">Le système de sécurité est actif. Seuls les aventuriers identifiés peuvent entrer.</p>
                </div>
            </div>
        </div>
    </div>
</div>