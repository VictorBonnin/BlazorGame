@page "/"
@inject BlazorGame.Client.Services.PlayerSessionService Session
@inject NavigationManager Navigation

<PageTitle>Accueil de l'Aventure</PageTitle>

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
        else
        {
            Navigation.NavigateTo("/new-adventure");
        }
    }
}