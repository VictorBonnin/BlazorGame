@page "/"
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text.Json

<PageTitle>Diagnostic BlazorGame</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">🕵️ Tour de Contrôle Keycloak</h3>
            <button class="btn btn-sm btn-light" @onclick="Rafraichir">🔄 Rafraîchir</button>
        </div>
        
        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3">Analyse de votre badge d'accès...</p>
                </div>
            }
            else if (isAuthenticated)
            {
                <div class="alert alert-success border-success">
                    <h4 class="alert-heading">✅ Authentification Réussie !</h4>
                    <p>L'application sait qui vous êtes : <strong>@userName</strong></p>
                </div>

                <div class="row mt-4">
                    <!-- ZONE CRITIQUE : LES RÔLES -->
                    <div class="col-md-6">
                        <div class="card border-primary h-100">
                            <div class="card-header bg-primary text-white">
                                🔑 Vos Rôles (Authorization)
                            </div>
                            <div class="card-body">
                                <p class="card-text text-muted">Si cette liste est vide, le jeu va boucler car vous n'aurez pas le droit d'entrer.</p>
                                
                                @if (roles.Any())
                                {
                                    <ul class="list-group">
                                        @foreach (var role in roles)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                @role
                                                <span class="badge bg-success rounded-pill">OK</span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="alert alert-danger">
                                        <strong>⚠️ AUCUN RÔLE DÉTECTÉ</strong>
                                        <hr>
                                        <p>C'est la cause du problème !</p>
                                        <ul>
                                            <li>Vérifiez que l'utilisateur a bien le rôle <code>player</code> dans Keycloak.</li>
                                            <li>Vérifiez que le fichier <code>CustomUserFactory.cs</code> est bien présent et enregistré.</li>
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ZONE TECHNIQUE : TOUS LES CLAIMS -->
                    <div class="col-md-6">
                        <div class="card border-secondary h-100">
                            <div class="card-header bg-secondary text-white">
                                📄 Données Brutes (Token)
                            </div>
                            <div class="card-body bg-light" style="max-height: 300px; overflow-y: auto;">
                                <small>
                                    <table class="table table-sm table-striped">
                                        <thead><tr><th>Type</th><th>Valeur</th></tr></thead>
                                        <tbody>
                                            @foreach (var claim in allClaims)
                                            {
                                                <tr>
                                                    <td class="text-break" style="width:40%">@claim.Type</td>
                                                    <td class="text-break">@claim.Value</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ZONE D'ACTION MANUELLE -->
                <div class="mt-4 text-center">
                    <p class="lead">Tests Manuels (Sans redirection auto)</p>
                    <a href="new-adventure" class="btn btn-lg btn-success mx-2">
                        🚀 Tenter "Nouvelle Aventure"
                    </a>
                    <button @onclick="Logout" class="btn btn-lg btn-outline-danger mx-2">
                        🚪 Se déconnecter
                    </button>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <div class="alert alert-warning">
                        <h4>🔒 Non Connecté</h4>
                        <p>Keycloak ne vous a pas reconnu ou le token a été perdu.</p>
                    </div>
                    <button class="btn btn-primary btn-lg" @onclick="GoToLogin">
                        🔑 Se connecter maintenant
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private string userName = "";
    private List<string> roles = new();
    private List<Claim> allClaims = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        isLoading = true;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        
        if (isAuthenticated)
        {
            userName = user.Identity?.Name ?? "Inconnu";
            allClaims = user.Claims.ToList();
            
            // On cherche tous les claims qui pourraient être des rôles
            roles = user.Claims
                .Where(c => c.Type == "role" || c.Type == ClaimTypes.Role || c.Type == "roles")
                .Select(c => c.Value)
                .ToList();
        }
        
        isLoading = false;
        // 🛑 AUCUNE REDIRECTION AUTOMATIQUE ICI
    }

    private void GoToLogin() => Navigation.NavigateTo("authentication/login");
    private void Logout() => Navigation.NavigateTo("authentication/logout");
    private async Task Rafraichir() => await LoadUser();
}