@page "/login"
@using System.Net.Http.Json
@using SharedModels.Entities
@using BlazorGame.Client.Services
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject PlayerSessionService Session
@inject NavigationManager Navigation

<PageTitle>Connexion Joueur</PageTitle>

<div class="card p-4">
    <h3>Connexion ou Création de Joueur</h3>
    <p>Entrez votre nom pour continuer l'aventure.</p>
    
    <EditForm Model="@Model" OnValidSubmit="HandleLoginOrCreate">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="userName">Nom d'utilisateur</label>
            <InputText id="userName" class="form-control" @bind-Value="Model.UserName" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@IsLoading">
            @if (IsLoading) {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            Démarrer la Session
        </button>
    </EditForm>
    
    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert @(Message.Contains("Erreur") ? "alert-danger" : "alert-success") mt-3">@Message</div>
    }
</div>

@code {
    private PlayerCreateModel Model { get; set; } = new();
    private string Message { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = false;

    // DTO local pour la création de joueur (PlayerCreate est dans GameServices, mais nous le redéfinissons pour la clarté du client)
    public class PlayerCreateModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(3)]
        public string? UserName { get; set; }
    }

    private async Task HandleLoginOrCreate()
    {
        IsLoading = true;
        Message = string.Empty;

        try
        {
            // 1. Tenter de créer le joueur via l'API
            var response = await Http.PostAsJsonAsync("api/players", new { Model.UserName });
            response.EnsureSuccessStatusCode();

            // 2. Récupérer le Player créé (ou l'entité de confirmation avec l'ID)
            var player = await response.Content.ReadFromJsonAsync<Player>();
            
            if (player?.Id > 0)
            {
                // 3. Connecter l'utilisateur dans la session
                Session.Login(player.Id, player.UserName!);
                
                Message = $"Bienvenue {player.UserName} ! Connexion réussie.";
                
                // 4. Rediriger vers la page du jeu
                Navigation.NavigateTo("/new-adventure", forceLoad: true);
            }
            else
            {
                Message = "Erreur: ID de joueur non reçu.";
            }
        }
        catch (Exception ex)
        {
            Message = $"Erreur lors de la connexion/création : {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}