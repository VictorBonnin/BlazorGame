@page "/login"
@inject BlazorGame.Client.Services.PlayerSessionService Session
@inject NavigationManager Navigation
@inject HttpClient Http
@using SharedModels.Entities

<PageTitle>Connexion</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <h2 class="mb-4 fw-bold text-primary">Identifiez-vous</h2>
                    
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger">@ErrorMessage</div>
                    }

                    <EditForm Model="this" OnValidSubmit="HandleLogin">
                        <div class="mb-3 text-start">
                            <label class="form-label">Nom d'utilisateur</label>
                            <InputText @bind-Value="Username" class="form-control form-control-lg" placeholder="Ex: Victor" />
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 btn-lg mt-3">
                            @(IsLoading ? "Chargement..." : "Entrer dans le jeu")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public string Username { get; set; } = "";
    public string ErrorMessage { get; set; } = "";
    public bool IsLoading { get; set; } = false;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(Username)) return;

        IsLoading = true;
        ErrorMessage = "";

        try
        {
            // 1. Création ou récupération du joueur via l'API
            var response = await Http.PostAsJsonAsync("api/players", new { UserName = Username });
            
            if (response.IsSuccessStatusCode)
            {
                var player = await response.Content.ReadFromJsonAsync<Player>();
                
                if (player != null)
                {
                    // 2. Enregistrement dans la session locale
                    Session.Login(player.Id, player.UserName);

                    // 3. REDIRECTION VERS L'ACCUEIL (Le Dashboard)
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                ErrorMessage = "Erreur de connexion au serveur.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur technique : {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}