@page "/room-component"
@using SharedModels
@using SharedModels.Entities
@using System.Linq

@* CORRECTION CS0234 & CS0102: L'injection Session a été retirée et les using sont corrigés *@

<div class="room-container">
    <h4 class="room-title">Salle @Room.Id</h4> @* CORRECTION CS1061: Index remplacé par Id *@

    <p class="room-type">Type : **@Room.Type** (Difficulté : @Room.Difficulty)</p>

    <div class="room-description alert alert-light">
        @Room.Description @* CORRECTION CS1061: EventDescription remplacé par Description *@
    </div>

    @if (Room.Monsters.Any())
    {
        <div class="monsters-section">
            <h5>Monstres à combattre :</h5>
            <ul>
                @foreach (var monster in Room.Monsters)
                {
                    <li>@monster.Name (PV: @monster.Health, Attaque: @monster.Attack)</li>
                }
            </ul>
        </div>
    }

    @if (Room.Loot.Any())
    {
        <div class="loot-section">
            <h5>Butin dans la salle :</h5>
            <ul>
                @foreach (var item in Room.Loot)
                {
                    <li>@item.Name (@item.Type, Valeur: @item.Value)</li>
                }
            </ul>
        </div>
    }

    @* Zone d'actions *@
    <div class="action-buttons mt-3">
        @if (!IsLoading)
        {
            <button class="btn btn-danger" @onclick="() => ChooseAction(PlayerAction.Combattre)">
                Combattre
            </button>
            <button class="btn btn-success" @onclick="() => ChooseAction(PlayerAction.Fouiller)">
                Fouiller
            </button>
            <button class="btn btn-warning" @onclick="() => ChooseAction(PlayerAction.Fuir)">
                Fuir
            </button>
            @if (Room.Loot.Any(i => i.Type == "Potion"))
            {
                <button class="btn btn-info" @onclick="() => ChooseAction(PlayerAction.UtiliserObjet)">
                    Utiliser Potion
                </button>
            }
        }
        else
        {
            <div class="text-center text-muted">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                Action en cours...
            </div>
        }
    </div>
</div>

@code {
    // Le code Razor utilise les propriétés définies dans RoomComponent.razor.cs
}