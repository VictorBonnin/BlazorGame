@page "/room-component"
@using SharedModels
@using SharedModels.Entities

<div class="card bg-secondary text-white mb-3">
    <div class="card-body text-center">
        
        @* On cache le Type technique pour laisser le suspense *@
        @* <h4 class="card-title">Salle @Room.Id</h4> *@
        
        @* La description est le seul indice du joueur *@
        <p class="card-text fs-4 fst-italic my-4">
            "@Room.Description"
        </p>

        @* Zone d'actions : TOUJOURS VISIBLES *@
        <div class="d-grid gap-2 d-md-block">
            @if (!IsLoading)
            {
                <button class="btn btn-danger btn-lg mx-2" @onclick="() => OnActionSelected.InvokeAsync(PlayerAction.Combattre)">
                    🗡️ COMBATTRE
                </button>
                
                <button class="btn btn-primary btn-lg mx-2" @onclick="() => OnActionSelected.InvokeAsync(PlayerAction.Fouiller)">
                    🔍 FOUILLER
                </button>
                
                <button class="btn btn-warning btn-lg mx-2" @onclick="() => OnActionSelected.InvokeAsync(PlayerAction.Fuir)">
                    🏃 FUIR
                </button>
            }
            else
            {
                <div class="spinner-border text-light" role="status"></div>
            }
        </div>
    </div>
</div>

@code {
    // RIEN ICI ! 
    // Tout est déjà géré dans RoomComponent.razor.cs
}