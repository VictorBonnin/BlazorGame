@using SharedModels.Entities
@using SharedModels

@* --- PARTIE HTML UNIQUEMENT --- *@
@* Les variables (Message, IsLoading, OnActionSelected) viennent du fichier .razor.cs *@

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info animate__animated animate__fadeIn">
        @Message
    </div>
}

<div class="d-grid gap-2 d-md-block mb-4">
    @if (!IsLoading)
    {
        <button class="btn btn-danger btn-lg mx-2" @onclick="() => OnActionSelected.InvokeAsync(PlayerAction.Combattre)">
            🗡️ COMBATTRE
        </button>
        
        <button class="btn btn-primary btn-lg mx-2" @onclick="() => OnActionSelected.InvokeAsync(PlayerAction.Fouiller)">
            🔍 FOUILLER
        </button>
            
        <button class="btn btn-warning btn-lg mx-2" @onclick="() => OnActionSelected.InvokeAsync(PlayerAction.Fuir)">
            🏃 FUIR
        </button>
    }
    else
    {
        <div class="spinner-border text-light" role="status"></div>
    }
</div>

<div class="card bg-dark text-white mb-3">
    <div class="card-header">
        🎒 Info (Compatibilité)
    </div>
    <div class="card-body">
       Ce composant est conservé pour la compatibilité.
    </div>
</div>