@using SharedModels.Entities

<div class="room-display p-3 border rounded @GetRoomCssClass()">
    <h4>Salle n°@Room.Index - Type : **@Room.Type**</h4>
    <p>Difficulté : **@Room.Difficulty**</p>

    {{-- Affichage de la description de l'événement --}}
    <div class="alert alert-secondary">
        @Room.EventDescription
    </div>

    <div class="action-buttons mt-3">
        @* Action de Combattre *@
        <button class="btn btn-danger m-1" @onclick="() => ChooseAction(PlayerAction.Combattre)" disabled="@IsLoading">
            <i class="oi oi-fire"></i> Combattre
        </button>

        @* Action de Fouiller *@
        <button class="btn btn-warning m-1" @onclick="() => ChooseAction(PlayerAction.Fouiller)" disabled="@IsLoading">
            <i class="oi oi-wrench"></i> Fouiller
        </button>

        @* Action de Fuir *@
        <button class="btn btn-info m-1" @onclick="() => ChooseAction(PlayerAction.Fuir)" disabled="@IsLoading">
            <i class="oi oi-run"></i> Fuir
        </button>
    </div>
</div>

@code {
    private string GetRoomCssClass() => Room.Type switch
    {
        RoomType.Combat => "bg-danger-subtle border-danger",
        RoomType.Loot => "bg-warning-subtle border-warning",
        RoomType.Trap => "bg-info-subtle border-info",
        _ => "bg-light border-secondary"
    };
}